{
  "name": "soulshard-hunter-frontend-tests",
  "private": true,
  "type": "module",
  "description": "Dev/test-only frontend smoke tests (Playwright). The game runtime itself stays zero-dependency.",
  "scripts": {
    "test:first-hunt": "node --test first-hunt.test.mjs service-worker.test.mjs && node first-hunt-browser.mjs",
    "test:frontend": "node frontend-smoke.mjs",
    "test:bot": "node --test \"../tools/bot/test/*.test.mjs\"",
    "bot": "node ../tools/bot/run.mjs",
    "test:authority": "node authority-parity.mjs && node authority-browser.mjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
